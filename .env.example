# Configuration for the Guacamole stack.
#
# You normally do NOT need to edit this. The launcher copies this file to ".env"
# on first run and fills in a strong random database password automatically.
# Edit ".env" (not this file) if you want to change something.

# Version of the Guacamole images to run.
GUAC_VERSION=1.6.0

# Port on your computer where Guacamole will be available.
# With the default, open http://localhost:8080/guacamole
WEB_PORT=8080

# Database settings. The password is generated for you on first run.
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=
